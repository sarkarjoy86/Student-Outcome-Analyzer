<style>
  body {
    font-family: Calibri, 'Segoe UI', Arial, sans-serif;
    font-size: 11pt;
    line-height: 1.4;
    color: #1f2937;
  }
  h1 {
    font-size: 18pt;
    color: #064e3b;
    border-bottom: 2pt solid #059669;
    padding-bottom: 6pt;
    margin-bottom: 12pt;
  }
  h2, h3 {
    font-size: 13pt;
    color: #0f172a;
    margin-top: 14pt;
    margin-bottom: 6pt;
  }
  .tip-box {
    background-color: #eff6ff;
    border-left: 4pt solid #3b82f6;
    padding: 8pt 12pt;
    margin: 10pt 0;
  }
  .speech-box {
    background-color: #f0fdf4;
    border-left: 4pt solid #10b981;
    padding: 8pt 12pt;
    margin: 8pt 0 12pt 0;
    font-style: italic;
    color: #064e3b;
  }
